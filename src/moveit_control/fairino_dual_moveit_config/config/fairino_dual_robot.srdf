<?xml version="1.0" encoding="UTF-8"?>
<!--This does not replace URDF, and is not an extension of URDF.
    This is a format for representing semantic information about the robot structure.
    A URDF file must exist for this robot as well, where the joints and the links that are referenced are defined
-->
<robot name="dual_robot">

    <group name="fairino16_v6_group">
        <joint name="robot2_j1"/>
        <joint name="robot2_j2"/>
        <joint name="robot2_j3"/>
        <joint name="robot2_j4"/>
        <joint name="robot2_j5"/>
        <joint name="robot2_j6"/>
        <chain base_link="robot2_base_link" tip_link="robot2_wrist3_link"/>
    </group>


    <group name="fairino5_v6_group">
        <joint name="robot1_j1"/>
        <joint name="robot1_j2"/>
        <joint name="robot1_j3"/>
        <joint name="robot1_j4"/>
        <joint name="robot1_j5"/>
        <joint name="robot1_j6"/>
        <chain base_link="robot1_base_link" tip_link="robot1_wrist3_link"/>
    </group>


    <!--DISABLE COLLISIONS: By default it is assumed that any link of the robot could potentially come into collision with any other link in the robot. This tag disables collision checking between a specified pair of links. -->
    <disable_collisions link1="robot2_base_link" link2="robot2_shoulder_link" reason="Adjacent"/>
    <disable_collisions link1="robot2_base_link" link2="robot2_upperarm_link" reason="Never"/>
    <disable_collisions link1="robot2_forearm_link" link2="robot2_shoulder_link" reason="Never"/>
    <disable_collisions link1="robot2_forearm_link" link2="robot2_upperarm_link" reason="Adjacent"/>
    <disable_collisions link1="robot2_forearm_link" link2="robot2_wrist1_link" reason="Adjacent"/>
    <disable_collisions link1="robot2_shoulder_link" link2="robot2_upperarm_link" reason="Adjacent"/>
    <disable_collisions link1="robot2_shoulder_link" link2="robot2_wrist1_link" reason="Never"/>
    <disable_collisions link1="robot2_upperarm_link" link2="robot2_wrist1_link" reason="Never"/>
    <disable_collisions link1="robot2_wrist1_link" link2="robot2_wrist2_link" reason="Adjacent"/>
    <disable_collisions link1="robot2_wrist1_link" link2="robot2_wrist3_link" reason="Never"/>
    <disable_collisions link1="robot2_wrist2_link" link2="robot2_wrist3_link" reason="Adjacent"/>   

    <!--DISABLE COLLISIONS: By default it is assumed that any link of the robot could potentially come into collision with any other link in the robot. This tag disables collision checking between a specified pair of links. -->
    <disable_collisions link1="robot1_base_link" link2="robot1_shoulder_link" reason="Adjacent"/>
    <disable_collisions link1="robot1_base_link" link2="robot1_upperarm_link" reason="Never"/>
    <disable_collisions link1="robot1_base_link" link2="robot1_wrist1_link" reason="Never"/>
    <disable_collisions link1="robot1_forearm_link" link2="robot1_shoulder_link" reason="Never"/>
    <disable_collisions link1="robot1_forearm_link" link2="robot1_upperarm_link" reason="Adjacent"/>
    <disable_collisions link1="robot1_forearm_link" link2="robot1_wrist1_link" reason="Adjacent"/>
    <disable_collisions link1="robot1_shoulder_link" link2="robot1_upperarm_link" reason="Adjacent"/>
    <disable_collisions link1="robot1_shoulder_link" link2="robot1_wrist1_link" reason="Never"/>
    <disable_collisions link1="robot1_wrist1_link" link2="robot1_wrist2_link" reason="Adjacent"/>
    <disable_collisions link1="robot1_wrist1_link" link2="robot1_wrist3_link" reason="Never"/>
    <disable_collisions link1="robot1_wrist2_link" link2="robot1_wrist3_link" reason="Adjacent"/>

    <disable_collisions link1="robot1_base_link" link2="base_dual_arm" reason="Adjacent"/>
    <disable_collisions link1="robot2_base_link" link2="base_dual_arm" reason="Adjacent"/>
    <disable_collisions link1="robot1_wrist3_link" link2="end1" reason="Adjacent"/>
    <disable_collisions link1="robot2_wrist3_link" link2="end2" reason="Adjacent"/>
    <disable_collisions link1="robot1_wrist3_link" link2="tcp1" reason="Adjacent"/>
    <disable_collisions link1="robot2_wrist3_link" link2="tcp2" reason="Adjacent"/>


<!-- Temporary disable. Dangerous!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!-->
    <disable_collisions link1="robot2_wrist3_link" link2="end2" reason="Adjacent"/>
    <disable_collisions link1="robot2_wrist2_link" link2="end2" reason="Adjacent"/>
    <disable_collisions link1="robot2_wrist1_link" link2="end2" reason="Adjacent"/>




</robot>
