<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dual_robot">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <xacro:include filename="$(find fairino_dual_moveit_config)/config/fairino.urdf" />

    <xacro:include filename="$(find fairino_dual_moveit_config)/config/fairino.ros2_control.xacro" />

    <xacro:fairino_dual_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
